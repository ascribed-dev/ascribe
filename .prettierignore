# Prettier formats the JavaScript workspace's code and config only.
#
# Markdown is excluded everywhere: Ascribe sources must not be reflowed by a
# formatter that doesn't know title and directive lines start new blocks
# (SPEC §10), and the project docs are hand-wrapped.
**/*.md

# Rust, test fixtures, and examples have their own formats and tools.
target/
crates/
tests/
examples/

# Generated and third-party files. The JSON Schemas are written by
# crates/ascribe-cli/src/shapes.rs, as serde_json prints them.
schemas/
# The plugin is written by crates/ascribe-cli/src/agents/plugin.rs.
plugins/
design/specimen.html
pnpm-lock.yaml
package-lock.json
**/.astro/
**/.ascribe/
**/dist/
**/out/
**/coverage/
**/node_modules/
