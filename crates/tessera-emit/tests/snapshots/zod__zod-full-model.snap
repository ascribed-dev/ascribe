// Generated by `ascribe build --emit site` from ascribe.toml. Don't edit it:
// change the content model and build again.
//
// The Zod schemas of the frontmatter in the site output, for an Astro content
// collection's `schema`. Written for Astro 7.3 (Zod 4, from `astro/zod`).

import { z } from "astro/zod";

/** One target of a page's availability: the attributes of a
 * `<ascribe-availability-target>`, and the text it shows. */
export const availableTargetSchema = z.strictObject({
  target: z.string(),
  dimension: z.string(),
  states: z.array(z.string()),
  versions: z.array(z.string()).optional(),
  text: z.string(),
});

/** A page's availability, for a layout to show with
 * `<ascribe-availability scope="page">`. */
export const availableSchema = z.array(availableTargetSchema);
export type Available = z.infer<typeof availableSchema>;

/** The dimension values a page applies to (SPEC §4.3). */
export const variantSchema = z.record(
  z.string(),
  z.union([z.string(), z.array(z.string())]),
);
export type Variant = z.infer<typeof variantSchema>;

/** The frontmatter of pages of type `guide`. */
export const guideSchema = z.strictObject({
  title: z.string().describe("The page title, shown in navigation and the browser tab."),
  description: z.string().optional(),
  order: z.number().optional(),
  featured: z.boolean().optional(),
  updated: z.coerce.date().optional(),
  level: z.enum(["beginner", "intermediate", "advanced"]).optional(),
  tags: z.array(z.string()).optional(),
  draft: z.boolean().default(false),
  status: z.enum(["draft", "review", "published"]).default("published"),
  category: z.enum(["Getting started", "How-to guides", "Concepts"]).optional(),
  keywords: z.array(z.string()).optional(),
  author: z.strictObject({
    name: z.string(),
    email: z.string().optional(),
  }).optional(),
  related: z.array(z.strictObject({
    title: z.string(),
    url: z.string(),
  })).optional(),
  available: availableSchema.optional(),
  variant: variantSchema.optional(),
});
export type Guide = z.infer<typeof guideSchema>;

/** The frontmatter of pages of type `reference`. */
export const referenceSchema = z.strictObject({
  title: z.string(),
  "api-version": z.string().optional(),
  available: availableSchema.optional(),
  variant: variantSchema.optional(),
});
export type Reference = z.infer<typeof referenceSchema>;

/** Every content type's schema, by the type's name. */
export const schemas = {
  guide: guideSchema,
  reference: referenceSchema,
} as const;

/** Which pages each content type applies to. */
export const contentTypes = {
  guide: { default: true, files: [] },
  reference: { default: false, files: ["reference/**", "api/**/*.md"] },
} as const;

/** A schema that accepts the frontmatter of any content type. */
export const schema = z.union([
  guideSchema,
  referenceSchema,
]);
