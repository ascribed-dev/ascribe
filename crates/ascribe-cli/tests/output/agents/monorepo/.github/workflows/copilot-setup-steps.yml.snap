# The environment Copilot's cloud agent works in. GitHub runs this job
# before the agent starts, from the default branch, and only under the
# name copilot-setup-steps.
name: Copilot setup steps

on:
  workflow_dispatch:
  push:
    paths:
      - .github/workflows/copilot-setup-steps.yml
  pull_request:
    paths:
      - .github/workflows/copilot-setup-steps.yml

jobs:
  copilot-setup-steps:
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - name: Check out the repository
        uses: actions/checkout@v7
      # ascribe:copilot start (generated by `ascribe agents sync --cloud`; run it again rather than editing this block)
      - name: Set up Node.js
        uses: actions/setup-node@v7
        with:
          node-version: 24
      - name: Install Ascribe
        shell: bash
        run: npm install --global @ascribed/cli@VERSION
      - name: Show Ascribe's version
        shell: bash
        run: ascribe --version
      # ascribe:copilot end
