{
  "name": "@ascribed/elements",
  "version": "0.1.0",
  "description": "Ascribe's web component library for the site output.",
  "type": "module",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ascribed-dev/ascribe.git",
    "directory": "packages/elements"
  },
  "homepage": "https://github.com/ascribed-dev/ascribe/tree/main/packages/elements#readme",
  "bugs": "https://github.com/ascribed-dev/ascribe/issues",
  "sideEffects": [
    "./dist/index.js",
    "*.css"
  ],
  "files": [
    "dist",
    "css",
    "CONTRACT.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./css/style.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "axe-core": "^4.10.0",
    "playwright-core": "^1.50.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
