{
  "name": "@ascribed/review",
  "version": "0.4.4",
  "description": "A toolchain for documentation written as code. This package reviews pages as readers see them: changed blocks marked on the rendered page, and a pull request's review threads beside them.",
  "type": "module",
  "license": "MPL-2.0",
  "author": "Bryo Studio <hello@bryostudio.com> (https://bryostudio.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ascribed-dev/ascribe.git",
    "directory": "packages/review"
  },
  "keywords": [
    "ascribe",
    "documentation",
    "markdown",
    "docs-as-code",
    "review",
    "pull-request"
  ],
  "homepage": "https://ascribed-dev.com/go/review-guide/",
  "bugs": "https://github.com/ascribed-dev/ascribe/issues",
  "sideEffects": false,
  "files": [
    "dist",
    "src/marks/marks.css",
    "README.md"
  ],
  "exports": {
    "./marks": {
      "types": "./dist/marks/index.d.ts",
      "default": "./dist/marks/index.js"
    },
    "./marks.css": "./src/marks/marks.css",
    "./overlay": {
      "types": "./dist/overlay/index.d.ts",
      "default": "./dist/overlay/index.js"
    },
    "./github": {
      "types": "./dist/github/index.d.ts",
      "default": "./dist/github/index.js"
    },
    "./place": {
      "types": "./dist/place/index.d.ts",
      "default": "./dist/place/index.js"
    },
    "./prompt": {
      "types": "./dist/prompt/index.d.ts",
      "default": "./dist/prompt/index.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "embed": "node embed.ts"
  },
  "devDependencies": {
    "@ascribed/elements": "workspace:*",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "smol-toml": "^1.9.1"
  }
}
