{
  "name": "@ascribed/review",
  "version": "0.1.1",
  "description": "Reviewing Ascribe pages as readers see them: changed blocks marked on the rendered page, and a pull request's review threads beside them.",
  "type": "module",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ascribed-dev/ascribe.git",
    "directory": "packages/review"
  },
  "homepage": "https://github.com/ascribed-dev/ascribe/tree/main/packages/review#readme",
  "bugs": "https://github.com/ascribed-dev/ascribe/issues",
  "sideEffects": false,
  "files": [
    "dist",
    "src/marks/marks.css",
    "README.md"
  ],
  "exports": {
    "./marks": {
      "types": "./dist/marks/index.d.ts",
      "default": "./dist/marks/index.js"
    },
    "./marks.css": "./src/marks/marks.css",
    "./overlay": {
      "types": "./dist/overlay/index.d.ts",
      "default": "./dist/overlay/index.js"
    },
    "./github": {
      "types": "./dist/github/index.d.ts",
      "default": "./dist/github/index.js"
    },
    "./place": {
      "types": "./dist/place/index.d.ts",
      "default": "./dist/place/index.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "embed": "node embed.ts"
  },
  "devDependencies": {
    "@ascribed/elements": "workspace:*",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
