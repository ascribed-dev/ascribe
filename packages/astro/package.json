{
  "name": "@ascribed/astro",
  "version": "0.4.5",
  "description": "A toolchain for documentation written as code. This package is its Astro integration, which publishes a project's pages as a site.",
  "type": "module",
  "license": "MPL-2.0",
  "author": "Bryo Studio <hello@bryostudio.com> (https://bryostudio.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ascribed-dev/ascribe.git",
    "directory": "packages/astro"
  },
  "keywords": [
    "ascribe",
    "documentation",
    "markdown",
    "docs-as-code",
    "astro",
    "astro-integration"
  ],
  "homepage": "https://ascribed-dev.com/go/astro-guide/",
  "bugs": "https://github.com/ascribed-dev/ascribe/issues",
  "sideEffects": false,
  "bin": {
    "ascribe-astro": "./dist/cli.js"
  },
  "files": [
    "dist",
    "starter",
    "src/Elements.astro",
    "src/Availability.astro",
    "src/Permalink.astro",
    "src/Gone.astro",
    "src/MissingPermalink.astro",
    "src/Head.astro",
    "src/Versions.astro",
    "src/VersionBanner.astro"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rehype": {
      "types": "./dist/rehype.d.ts",
      "default": "./dist/rehype.js"
    },
    "./satteri": {
      "types": "./dist/satteri.d.ts",
      "default": "./dist/satteri.js"
    },
    "./Elements.astro": "./src/Elements.astro",
    "./Availability.astro": "./src/Availability.astro",
    "./MissingPermalink.astro": "./src/MissingPermalink.astro",
    "./Head.astro": "./src/Head.astro",
    "./Versions.astro": "./src/Versions.astro",
    "./VersionBanner.astro": "./src/VersionBanner.astro",
    "./content": {
      "types": "./dist/content.d.ts",
      "default": "./dist/content.js"
    },
    "./permalinks": {
      "types": "./dist/permalinks.d.ts",
      "default": "./dist/permalinks.js"
    },
    "./redirects": {
      "types": "./dist/redirects.d.ts",
      "default": "./dist/redirects.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ascribed/cli": "workspace:*",
    "@ascribed/elements": "workspace:*",
    "@ascribed/review": "workspace:*",
    "github-slugger": "^2.0.0",
    "property-information": "^7.2.0",
    "smol-toml": "^1.9.1"
  },
  "peerDependencies": {
    "@types/hast": "^3.0.0",
    "astro": "^7.3.5",
    "satteri": "^0.10.3"
  },
  "peerDependenciesMeta": {
    "@types/hast": {
      "optional": true
    },
    "satteri": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/node": "^24.19.2",
    "astro": "7.4.2",
    "hast-util-from-html": "^2.0.3",
    "jsdom": "^30.1.3",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-smartypants": "^3.0.2",
    "satteri": "0.10.5",
    "unified": "^11.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
