{
  "name": "@ascribed/astro",
  "version": "0.1.1",
  "description": "The Astro integration for Ascribe.",
  "type": "module",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ascribed-dev/ascribe.git",
    "directory": "packages/astro"
  },
  "homepage": "https://github.com/ascribed-dev/ascribe/tree/main/packages/astro#readme",
  "bugs": "https://github.com/ascribed-dev/ascribe/issues",
  "sideEffects": false,
  "files": [
    "dist",
    "src/Elements.astro"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rehype": {
      "types": "./dist/rehype.d.ts",
      "default": "./dist/rehype.js"
    },
    "./satteri": {
      "types": "./dist/satteri.d.ts",
      "default": "./dist/satteri.js"
    },
    "./Elements.astro": "./src/Elements.astro",
    "./content": {
      "types": "./dist/content.d.ts",
      "default": "./dist/content.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ascribed/cli": "workspace:*",
    "@ascribed/elements": "workspace:*",
    "@ascribed/review": "workspace:*",
    "property-information": "^7.2.0",
    "smol-toml": "^1.9.0"
  },
  "peerDependencies": {
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/node": "^24.0.0",
    "astro": "7.3.5",
    "hast-util-from-html": "^2.0.3",
    "jsdom": "^30.1.1",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-smartypants": "^3.0.2",
    "satteri": "0.10.5",
    "unified": "^11.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
