---
import { getCollection, type CollectionEntry } from "astro:content";
import type { ComponentProps } from "astro/types";
import Availability from "@ascribed/astro/Availability.astro";
import Elements from "@ascribed/astro/Elements.astro";
// Everything the head says about the page, from its record.
import Head from "@ascribed/astro/Head.astro";
// With a versioned build, the lines that have the page, and on an older line
// what it is and where the current one is.
import Versions from "@ascribed/astro/Versions.astro";
import VersionBanner from "@ascribed/astro/VersionBanner.astro";
import {
  neighbors,
  sidebar,
  type Formatted,
  type SidebarGroup,
  type SidebarPage,
} from "@ascribed/astro/content";
// The layout's styles. To style the site your own way, change the file, or
// delete it and this line.
import "../styles/docs.css";

interface Props {
  entry: CollectionEntry<"docs">;
  headings: { depth: number; slug: string; text: string }[];
}

/**
 * What the layout reads of a page's frontmatter: `title`, which every content
 * type has, and what a type may have. `title` is plain text; `formatted.title`
 * is the title as HTML, with its code spans as <code>, when the content model
 * sets `inline = "code"` on `title`.
 */
interface Page {
  title: string;
  available?: ComponentProps<typeof Availability>["available"];
  formatted?: { title?: string };
}

const { entry, headings } = Astro.props;
const page = (of: CollectionEntry<"docs">) => of.data as Page;
const escape = (text: string) =>
  text.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");
/** A page's title as HTML: its formatted form, or its plain text escaped. */
const titleHtml = (of: CollectionEntry<"docs">) =>
  page(of).formatted?.title ?? escape(page(of).title);
/** A sidebar label as HTML: its formatted form, or its plain text escaped. */
const labelHtml = (of: { label: string; formatted?: Formatted }) =>
  of.formatted?.label ?? escape(of.label);
const { available } = page(entry);
// The sidebar: the project's navigation, in ascribe.nav's order or the
// default one, each page with its address and label, and a nested section's
// pages right after its own page, each with its depth. With a versioned build,
// it shows the pages of the line this page is in. Previous and next are the
// pages before and after this one in the navigation's reading order.
//
// The default order puts a section's pages by content type, then title, so
// "Configure" comes before "Install". To choose another, write ascribe.nav
// beside ascribe.toml, or drag the pages in the editor: the docs' "Put your
// pages in order" says how.
const entries = await getCollection("docs");
const groups = sidebar(entries, { entry });
const { previous, next } = neighbors(entry, entries);

/** A sidebar page, with how many sections deep it is: 0 in a top section. */
interface Item {
  page: SidebarPage<CollectionEntry<"docs">>;
  depth: number;
}

/**
 * A group's pages in order, each nested section's right after its own page,
 * or after the group's pages when its own page is its `index.md`.
 */
function items(group: SidebarGroup<CollectionEntry<"docs">>, depth = 0): Item[] {
  const placed = new Set<SidebarGroup<CollectionEntry<"docs">>>();
  const out: Item[] = [];
  for (const page of group.pages) {
    out.push({ page, depth });
    for (const section of group.sections) {
      if (section.page?.entry !== page.entry) continue;
      placed.add(section);
      out.push(...items(section, depth + 1));
    }
  }
  for (const section of group.sections) {
    if (!placed.has(section)) out.push(...items(section, depth + 1));
  }
  return out;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Head entry={entry} />
    <Elements />
  </head>
  <body>
    <details class="menu">
      <summary>Menu</summary>
      <nav aria-label="Docs">
        {
          groups.map((group) => (
            <section>
              <h2 set:html={labelHtml(group)} />
              <ul>
                {items(group).map(({ page: item, depth }) => (
                  <li data-depth={depth}>
                    <a
                      href={item.href}
                      aria-current={item.entry.id === entry.id ? "page" : undefined}
                    >
                      <Fragment set:html={labelHtml(item)} />
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </nav>
    </details>
    <main>
      <VersionBanner entry={entry} />
      <h1 set:html={titleHtml(entry)} />
      <Availability available={available} />
      <Versions entry={entry} />
      <div class="page">
        {
          headings.length > 0 && (
            <nav aria-label="On this page">
              <ul>
                {headings.map((heading) => (
                  <li data-depth={heading.depth}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
        <article><slot /></article>
      </div>
      <nav aria-label="Previous and next">
        {
          previous && (
            <a rel="prev" href={previous.href}>
              Previous: <Fragment set:html={labelHtml(previous)} />
            </a>
          )
        }
        {
          next && (
            <a rel="next" href={next.href}>
              Next: <Fragment set:html={labelHtml(next)} />
            </a>
          )
        }
      </nav>
    </main>
  </body>
</html>
