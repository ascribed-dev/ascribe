---
// Loads the element library (phase 19) on the pages that render Ascribe
// content: put `<Elements />` in the layout's <head>. The stylesheet is
// imported in the frontmatter, so Astro links it in the page that uses this
// component; the script is bundled once and loaded as a module.
//
// (`injectScript("page", …)` is not used: Astro 7.3.5 bundles an injected
// script but drops the CSS it imports.)
import "@ascribed/elements/style.css";
---

<script>
  import "@ascribed/elements";
</script>
