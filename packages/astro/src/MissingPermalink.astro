---
// For a site's not-found page: on an address under the permalinks' path, it
// says the link came from a product that expected a section of these docs
// there, and that these docs don't have it. Anywhere else it shows nothing. A
// static host serves one not-found page for every missing address, so its
// script decides from the address, and without a script it stays hidden.
//
//   import MissingPermalink from "@ascribed/astro/MissingPermalink.astro";
//   <MissingPermalink />
//
// `home` is where it sends the reader, the site's root by default. Children
// replace its last paragraph, which offers the home page and searching.
import { home as root, siteRoot } from "virtual:ascribe/site";
import { readPermalinks } from "@ascribed/astro/permalinks";

interface Props {
  home?: string;
}

const { home = root } = Astro.props;
const path = readPermalinks(siteRoot)?.path;
---

{
  path !== undefined && (
    <section data-permalinks={path} hidden>
      <p>
        This address is a permalink, <code />: a name a product links to for a section of its
        documentation. These docs have no section by that name. The link may come from a newer or
        older version of the product than they describe.
      </p>
      <slot>
        <p>Start from the <a href={home}>home page</a>, or search the docs for what you need.</p>
      </slot>
    </section>
  )
}

<script>
  for (const section of document.querySelectorAll<HTMLElement>("section[data-permalinks]")) {
    const path = section.dataset["permalinks"] ?? "";
    let address: string;
    try {
      address = decodeURIComponent(location.pathname);
    } catch {
      continue;
    }
    if (!address.startsWith(path)) continue;
    // One segment after the path, as every permalink's address has.
    const name = address.slice(path.length).replace(/\/$/, "");
    if (name === "" || name.includes("/")) continue;
    const code = section.querySelector("code");
    if (code !== null) code.textContent = name;
    section.hidden = false;
  }
</script>
