---
// The lines of a versioned build, as a list, newest first, from
// `<output-dir>/_ascribe/versions.json`: each line's number, linking to the
// page in that line, with the page's own line marked `aria-current="page"`
// and the current line `data-current`. A line that doesn't have the page
// links to the page that takes its place there, when one says so with
// `replaces`, and is shown unlinked otherwise, with words saying so. The
// archived lines that have an address follow, each linking to it, with a
// word saying it's archived. A layout includes it given the page's collection
// entry:
//
//   import Versions from "@ascribed/astro/Versions.astro";
//   <Versions entry={entry} />
//
// It renders nothing for a page of a build that isn't versioned, or of a
// build with one line to list. It writes no styles: the site's own select it
// by `nav[aria-label]`, or the `class` given.
import { lineVersions } from "@ascribed/astro/content";

interface Props {
  /** The page's collection entry. */
  entry: { filePath?: string | undefined; data?: unknown };
  /** The list's accessible name. Default: "Versions". */
  label?: string;
  /** After a line that doesn't have the page. Default: "(not in this version)". */
  missing?: string;
  /** After an archived line. Default: "(archived)". */
  archived?: string;
  /** A class for the `<nav>`. */
  class?: string;
}

const {
  entry,
  label = "Versions",
  missing = "(not in this version)",
  archived = "(archived)",
  class: className,
} = Astro.props;
const versions = lineVersions(entry);
---

{
  versions.length > 1 && (
    <nav aria-label={label} class={className}>
      <ul>
        {versions.map((version) => (
          <li>
            {version.route === undefined ? (
              <span data-line={version.line} data-missing>
                {version.line} {missing}
              </span>
            ) : (
              <a
                href={version.route}
                aria-current={version.own ? "page" : undefined}
                data-line={version.line}
                data-current={version.status === "current" ? "" : undefined}
                data-archived={version.status === "archived" ? "" : undefined}
              >
                {version.status === "archived" ? `${version.line} ${archived}` : version.line}
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>
  )
}
