{
  "name": "@ascribed/cli",
  "version": "0.2.0",
  "description": "The Ascribe command-line tool.",
  "type": "module",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ascribed-dev/ascribe.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/ascribed-dev/ascribe/tree/main/packages/cli#readme",
  "bugs": "https://github.com/ascribed-dev/ascribe/issues",
  "files": [
    "dist",
    "skills"
  ],
  "bin": {
    "ascribe": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./binary": {
      "types": "./dist/binary.d.ts",
      "default": "./dist/binary.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "stage-native": "node ./scripts/stage-native.mjs"
  },
  "optionalDependencies": {
    "@ascribed/cli-darwin-arm64": "workspace:*",
    "@ascribed/cli-linux-arm64": "workspace:*",
    "@ascribed/cli-linux-x64": "workspace:*",
    "@ascribed/cli-win32-x64": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
