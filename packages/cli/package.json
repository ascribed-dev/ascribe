{
  "name": "@ascribed/cli",
  "version": "0.4.2",
  "description": "A toolchain for documentation written as code. This package installs its command, ascribe.",
  "type": "module",
  "license": "MPL-2.0",
  "author": "Bryo Studio <hello@bryostudio.com> (https://bryostudio.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ascribed-dev/ascribe.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "ascribe",
    "documentation",
    "markdown",
    "docs-as-code",
    "cli"
  ],
  "homepage": "https://ascribed-dev.com/go/getting-started/",
  "bugs": "https://github.com/ascribed-dev/ascribe/issues",
  "files": [
    "dist",
    "skills"
  ],
  "bin": {
    "ascribe": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./binary": {
      "types": "./dist/binary.d.ts",
      "default": "./dist/binary.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "stage-native": "node ./scripts/stage-native.mjs"
  },
  "optionalDependencies": {
    "@ascribed/cli-darwin-arm64": "workspace:*",
    "@ascribed/cli-linux-arm64": "workspace:*",
    "@ascribed/cli-linux-x64": "workspace:*",
    "@ascribed/cli-win32-x64": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.19.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
