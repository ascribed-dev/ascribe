{
  "name": "ascribe-vscode",
  "displayName": "Ascribe",
  "version": "0.2.0",
  "description": "The Ascribe extension for VS Code.",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ascribed-dev/ascribe.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://ascribed-dev.com/guides/editor/",
  "bugs": "https://github.com/ascribed-dev/ascribe/issues",
  "publisher": "Ascribe",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#13171f",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "ascribe",
    "markdown",
    "documentation",
    "docs-as-code",
    "language-server"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "workspaceContains:**/ascribe.toml",
    "onWebviewPanel:ascribe.preview"
  ],
  "ascribe": {
    "minServerVersion": "0.2.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "ascribe.restartServer",
        "title": "Restart Language Server",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.showOutput",
        "title": "Show Server Output",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.openPagePreview",
        "title": "Open Page Preview",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.openPreview",
        "title": "Open Page Preview to the Side",
        "category": "Ascribe",
        "icon": "$(open-preview)"
      },
      {
        "command": "ascribe.openSitePreview",
        "title": "Open Site Preview",
        "category": "Ascribe",
        "icon": "$(globe)"
      },
      {
        "command": "ascribe.selectPreviewBuild",
        "title": "Select Preview Build",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.switchBuild",
        "title": "Switch Build",
        "category": "Ascribe",
        "icon": "$(package)"
      },
      {
        "command": "ascribe.projectMenu",
        "title": "Project Menu",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.toggleBuildLens",
        "title": "Dim What the Build Leaves Out",
        "category": "Ascribe",
        "icon": "$(eye)"
      },
      {
        "command": "ascribe.projects.refresh",
        "title": "Refresh",
        "category": "Ascribe",
        "icon": "$(refresh)"
      },
      {
        "command": "ascribe.projects.showOutput",
        "title": "Show Output",
        "category": "Ascribe",
        "icon": "$(output)"
      },
      {
        "command": "ascribe.projects.restart",
        "title": "Restart Server",
        "category": "Ascribe",
        "icon": "$(debug-restart)"
      },
      {
        "command": "ascribe.startReview",
        "title": "Start Review",
        "category": "Ascribe",
        "icon": "$(git-compare)"
      },
      {
        "command": "ascribe.stopReview",
        "title": "Stop Review",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.changedPages",
        "title": "Changed Pages",
        "category": "Ascribe",
        "icon": "$(list-unordered)"
      },
      {
        "command": "ascribe.refreshComments",
        "title": "Refresh Comments",
        "category": "Ascribe",
        "icon": "$(refresh)"
      },
      {
        "command": "ascribe.review.replyNow",
        "title": "Reply Now",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.review.addToReview",
        "title": "Add to Review",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.review.resolve",
        "title": "Resolve",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.review.reopen",
        "title": "Reopen",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.actions",
        "title": "Actions for the Cursor",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.action.wrapNote",
        "title": "Wrap in a note",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.action.setNoteType",
        "title": "Change the note's kind",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.action.unwrapNote",
        "title": "Remove the note, keeping its text",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.action.noteToDetails",
        "title": "Turn the note into collapsible details",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.action.wrapDetails",
        "title": "Wrap in collapsible details",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.action.unwrapDetails",
        "title": "Remove the details, keeping the content",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.action.makeSteps",
        "title": "Make the list steps",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.action.removeSteps",
        "title": "Make the steps a plain list",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.action.addHeadingId",
        "title": "Give the heading a stable id",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.action.copyLinkToSection",
        "title": "Copy a link to this section",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.action.insertNote",
        "title": "Insert a note",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.action.insertSteps",
        "title": "Insert steps",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.action.insertDetails",
        "title": "Insert collapsible details",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.action.insertVariantGroup",
