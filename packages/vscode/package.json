{
  "name": "ascribe-vscode",
  "displayName": "Ascribe",
  "version": "0.2.0",
  "description": "The Ascribe extension for VS Code.",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ascribed-dev/ascribe.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://ascribed-dev.com/guides/editor/",
  "bugs": "https://github.com/ascribed-dev/ascribe/issues",
  "publisher": "Ascribe",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "ascribe",
    "markdown",
    "documentation",
    "docs-as-code",
    "language-server"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "workspaceContains:**/ascribe.toml",
    "onWebviewPanel:ascribe.preview"
  ],
  "ascribe": {
    "minServerVersion": "0.2.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "ascribe.restartServer",
        "title": "Restart Language Server",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.showOutput",
        "title": "Show Server Output",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.openPagePreview",
        "title": "Open Page Preview",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.openPreview",
        "title": "Open Page Preview to the Side",
        "category": "Ascribe",
        "icon": "$(open-preview)"
      },
      {
        "command": "ascribe.openSitePreview",
        "title": "Open Site Preview",
        "category": "Ascribe",
        "icon": "$(globe)"
      },
      {
        "command": "ascribe.selectPreviewBuild",
        "title": "Select Preview Build",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.startReview",
        "title": "Start Review",
        "category": "Ascribe",
        "icon": "$(git-compare)"
      },
      {
        "command": "ascribe.stopReview",
        "title": "Stop Review",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.changedPages",
        "title": "Changed Pages",
        "category": "Ascribe",
        "icon": "$(list-unordered)"
      },
      {
        "command": "ascribe.refreshComments",
        "title": "Refresh Comments",
        "category": "Ascribe",
        "icon": "$(refresh)"
      },
      {
        "command": "ascribe.review.replyNow",
        "title": "Reply Now",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.review.addToReview",
        "title": "Add to Review",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.review.resolve",
        "title": "Resolve",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.review.reopen",
        "title": "Reopen",
        "category": "Ascribe"
      }
    ],
    "configuration": {
      "title": "Ascribe",
      "properties": {
        "ascribe.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "The `ascribe` binary to run, for every project. When empty, each project's own `node_modules/.bin/ascribe`, then the binary included in the extension. Changing it restarts the servers that have started."
        },
        "ascribe.startServers": {
          "type": "string",
          "enum": [
            "onDemand",
            "all"
          ],
          "enumDescriptions": [
            "Start a project's language server the first time one of its files is opened.",
            "Start every project's language server when the workspace opens."
          ],
          "default": "onDemand",
          "scope": "window",
          "markdownDescription": "When to start the language server of each `ascribe.toml` project in the workspace. A project whose server hasn't started shows no problems in the Problems panel."
        },
        "ascribe.formatOnSave": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Format Ascribe constructs into canonical form when saving."
        },
        "ascribe.preview.scrollPreviewWithEditor": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Scroll the preview to the block at the top of the editor, and to the block the cursor moves to when it's out of view."
        },
        "ascribe.preview.scrollEditorWithPreview": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Scroll the editor to the line of the block at the top of the preview when the preview is scrolled."
        },
        "ascribe.review.sourceComments": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "enumDescriptions": [
            "Show review threads on source lines unless the GitHub Pull Requests extension is active, which shows them already.",
            "Always show review threads on source lines.",
            "Show review threads in the page preview only."
          ],
          "default": "auto",
          "scope": "window",
          "markdownDescription": "Whether the source editor shows the pull request's review threads on the lines they're on, while review is on."
        },
        "ascribe.maxCrashes": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "markdownDescription": "How many crashes of a project's language server, since it was last restarted by hand, make the extension stop restarting it and explain why."
        },
        "ascribe.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "enumDescriptions": [
            "Log nothing.",
            "Log each message's name and timing.",
            "Log each message with its content."
          ],
          "default": "off",
          "markdownDescription": "Log the conversation with the language server to its output channel, for reporting a problem."
        }
      }
    },
    "grammars": [
      {
        "scopeName": "ascribe.injection",
        "path": "./syntaxes/ascribe.injection.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.ascribe": "ascribe"
        }
      },
      {
        "scopeName": "ascribe.injection.nested",
        "path": "./syntaxes/ascribe.injection.nested.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ]
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "ascribeDirective",
        "superType": "keyword",
        "description": "A built-in directive's `@` and name."
      },
      {
        "id": "ascribeWidget",
        "superType": "function",
        "description": "A project widget's `@` and name."
      },
      {
        "id": "ascribeAttributeKey",
        "superType": "property",
        "description": "An attribute key in a `{…}` block."
      },
      {
        "id": "ascribeAttributeValue",
        "superType": "string",
        "description": "An attribute value."
      },
      {
        "id": "ascribeColon",
        "superType": "operator",
        "description": "The colon that ends a directive's head."
      },
      {
        "id": "ascribeEnd",
        "superType": "keyword",
        "description": "The `@end` of an end line."
      },
      {
        "id": "ascribeTitle",
        "superType": "string",
        "description": "A title line (SPEC §3.7), shown distinctly so an accidental title stands out."
      },
      {
        "id": "ascribePhrase",
        "superType": "variable",
        "description": "A declared phrase, `{key}`."
      },
      {
        "id": "ascribePhraseUndeclared",
        "superType": "variable",
        "description": "A `{key}` the content model doesn't declare."
      },
      {
        "id": "ascribeAvailability",
        "superType": "constant",
        "description": "An availability spec."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "markdown",
        "scopes": {
          "ascribeDirective": [
            "keyword.control.directive.ascribe"
          ],
          "ascribeWidget": [
            "entity.name.function.widget.ascribe"
          ],
          "ascribeAttributeKey": [
            "entity.other.attribute-name.ascribe"
          ],
          "ascribeAttributeValue": [
            "string.unquoted.attribute-value.ascribe"
          ],
          "ascribeColon": [
            "punctuation.separator.directive.ascribe"
          ],
          "ascribeEnd": [
            "keyword.control.end.ascribe"
          ],
          "ascribeTitle": [
            "markup.heading.title.ascribe"
          ],
          "ascribePhrase": [
            "variable.other.phrase.ascribe"
          ],
          "ascribePhraseUndeclared": [
            "invalid.illegal.phrase-undeclared.ascribe"
          ],
          "ascribeAvailability": [
            "constant.other.availability.ascribe"
          ],
          "ascribeAttributeKey.unknown": [
            "invalid.illegal.attribute-unknown.ascribe"
          ]
        }
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "unknown",
        "description": "An attribute key the directive's schema doesn't declare."
      }
    ],
    "configurationDefaults": {
      "[markdown]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "ascribe.restartServer",
          "when": "ascribe.active"
        },
        {
          "command": "ascribe.showOutput",
          "when": "ascribe.active"
        },
        {
          "command": "ascribe.openPagePreview",
          "when": "ascribe.active"
        },
        {
          "command": "ascribe.openPreview",
          "when": "ascribe.active"
        },
        {
          "command": "ascribe.openSitePreview",
          "when": "ascribe.active"
        },
        {
          "command": "ascribe.selectPreviewBuild",
          "when": "ascribe.active && ascribe.previewOpen"
        },
        {
          "command": "ascribe.startReview",
          "when": "ascribe.active"
        },
        {
          "command": "ascribe.stopReview",
          "when": "ascribe.active && ascribe.reviewOn"
        },
        {
          "command": "ascribe.changedPages",
          "when": "ascribe.active"
        },
        {
          "command": "ascribe.refreshComments",
          "when": "ascribe.active && ascribe.reviewOn"
        },
        {
          "command": "ascribe.review.replyNow",
          "when": "false"
        },
        {
          "command": "ascribe.review.addToReview",
          "when": "false"
        },
        {
          "command": "ascribe.review.resolve",
          "when": "false"
        },
        {
          "command": "ascribe.review.reopen",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "ascribe.openPreview",
          "when": "ascribe.active && resourceLangId == markdown",
          "group": "navigation"
        },
        {
          "command": "ascribe.openSitePreview",
          "when": "ascribe.active && ascribe.devServer && resourceLangId == markdown",
          "group": "navigation"
        },
        {
          "command": "ascribe.startReview",
          "when": "activeWebviewPanelId == 'ascribe.preview' && !ascribe.reviewOn",
          "group": "navigation"
        },
        {
          "command": "ascribe.changedPages",
          "when": "activeWebviewPanelId == 'ascribe.preview' && ascribe.reviewOn",
          "group": "navigation"
        },
        {
          "command": "ascribe.refreshComments",
          "when": "activeWebviewPanelId == 'ascribe.preview' && ascribe.reviewOn",
          "group": "navigation"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "ascribe.review.addToReview",
          "when": "commentController == ascribe.review && (commentThreadIsEmpty || commentThread =~ /\\bcanReply\\b/)",
          "group": "inline@1"
        },
        {
          "command": "ascribe.review.replyNow",
          "when": "commentController == ascribe.review && !commentThreadIsEmpty && commentThread =~ /\\bcanReply\\b/",
          "group": "inline@2"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "ascribe.review.resolve",
          "when": "commentController == ascribe.review && commentThread =~ /\\bcanResolve\\b/",
          "group": "inline"
        },
        {
          "command": "ascribe.review.reopen",
          "when": "commentController == ascribe.review && commentThread =~ /\\bcanUnresolve\\b/",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "stage-server": "node scripts/stage-server.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.webview.json",
    "test": "vitest run --passWithNoTests",
    "test:integration": "node esbuild.mjs --tests && node out/integration/run.cjs",
    "test:integration:headless": "xvfb-run -a pnpm run test:integration",
    "test:parity": "vitest run --config vitest.parity.config.ts"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  },
  "devDependencies": {
    "@ascribed/elements": "workspace:*",
    "@ascribed/review": "workspace:*",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.9",
    "@types/vscode": "~1.140.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.3",
    "playwright-core": "^1.50.0",
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Ascribe runs the project own ascribe binary (node_modules/.bin/ascribe or the ascribe.path setting), which is code the workspace supplies."
    }
  }
}
