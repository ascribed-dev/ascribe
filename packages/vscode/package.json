        {
          "command": "ascribe.projects.refresh",
          "when": "view == ascribe.projects",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "ascribe.projects.showOutput",
          "when": "view == ascribe.projects && viewItem =~ /^ascribe\\.project\\./",
          "group": "inline@1"
        },
        {
          "command": "ascribe.projects.restart",
          "when": "view == ascribe.projects && viewItem =~ /^ascribe\\.project\\.(running|failed)$/",
          "group": "inline@2"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "ascribe.review.addToReview",
          "when": "commentController == ascribe.review && (commentThreadIsEmpty || commentThread =~ /\\bcanReply\\b/)",
          "group": "inline@1"
        },
        {
          "command": "ascribe.review.replyNow",
          "when": "commentController == ascribe.review && !commentThreadIsEmpty && commentThread =~ /\\bcanReply\\b/",
          "group": "inline@2"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "ascribe.review.resolve",
          "when": "commentController == ascribe.review && commentThread =~ /\\bcanResolve\\b/",
          "group": "inline"
        },
        {
          "command": "ascribe.review.promptAgent",
          "when": "commentController == ascribe.review && !commentThreadIsEmpty",
          "group": "inline@0"
        },
        {
          "command": "ascribe.review.reopen",
          "when": "commentController == ascribe.review && commentThread =~ /\\bcanUnresolve\\b/",
          "group": "inline"
        }
