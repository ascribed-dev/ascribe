        "title": "Add a variant",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.action.removeVariantArm",
        "title": "Remove this variant",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.action.markAvailable",
        "title": "Mark where it's available",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.action.setPageVariant",
        "title": "Make the page one variant",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.action.setPageAvailable",
        "title": "Set where the page is available",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.action.linkSelection",
        "title": "Link the selected text",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.action.insertLink",
        "title": "Insert a link",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.action.setLinkTarget",
        "title": "Change where the link goes",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.action.useTargetTitle",
        "title": "Show the page's title as the link text",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.action.insertPhrase",
        "title": "Insert a phrase",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.action.insertImage",
        "title": "Insert an image",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.action.setImageWidth",
        "title": "Set the image's width",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.action.setImageAlt",
        "title": "Change the image's description",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.action.insertInclude",
        "title": "Include a fragment",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.action.insertSnippet",
        "title": "Insert a code snippet",
        "category": "Ascribe"
      },
      {
        "command": "ascribe.action.insertWidget",
        "title": "Insert a widget",
        "category": "Ascribe"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ascribe",
          "title": "Ascribe",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "ascribe": [
        {
          "id": "ascribe.projects",
          "name": "Projects",
          "contextualTitle": "Ascribe"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ascribe.projects",
        "contents": "This workspace has no Ascribe project yet. A project is a folder with an ascribe.toml, which describes its pages and builds.\n[Get started with Ascribe](https://ascribed-dev.com/getting-started/)"
      }
    ],
    "configuration": {
      "title": "Ascribe",
      "properties": {
        "ascribe.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "The `ascribe` binary to run, for every project. When empty, each project's own `node_modules/.bin/ascribe`, then the binary included in the extension. Changing it restarts the servers that have started."
        },
        "ascribe.startServers": {
          "type": "string",
          "enum": [
            "onDemand",
            "all"
          ],
          "enumDescriptions": [
            "Start a project's language server the first time one of its files is opened.",
            "Start every project's language server when the workspace opens."
          ],
          "default": "onDemand",
          "scope": "window",
          "markdownDescription": "When to start the language server of each `ascribe.toml` project in the workspace. A project whose server hasn't started shows no problems in the Problems panel."
        },
        "ascribe.formatOnSave": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Format Ascribe constructs into canonical form when saving."
        },
        "ascribe.preview.scrollPreviewWithEditor": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Scroll the preview to the block at the top of the editor, and to the block the cursor moves to when it's out of view."
        },
        "ascribe.preview.scrollEditorWithPreview": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Scroll the editor to the line of the block at the top of the preview when the preview is scrolled."
        },
        "ascribe.review.sourceComments": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "enumDescriptions": [
            "Show review threads on source lines unless the GitHub Pull Requests extension is active, which shows them already.",
            "Always show review threads on source lines.",
            "Show review threads in the page preview only."
          ],
          "default": "auto",
          "scope": "window",
          "markdownDescription": "Whether the source editor shows the pull request's review threads on the lines they're on, while review is on."
        },
        "ascribe.maxCrashes": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "markdownDescription": "How many crashes of a project's language server, since it was last restarted by hand, make the extension stop restarting it and explain why."
        },
        "ascribe.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "enumDescriptions": [
            "Log nothing.",
            "Log each message's name and timing.",
            "Log each message with its content."
          ],
          "default": "off",
          "markdownDescription": "Log the conversation with the language server to its output channel, for reporting a problem."
        }
      }
    },
    "grammars": [
      {
        "scopeName": "ascribe.injection",
        "path": "./syntaxes/ascribe.injection.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.ascribe": "ascribe"
        }
      },
      {
        "scopeName": "ascribe.injection.nested",
        "path": "./syntaxes/ascribe.injection.nested.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ]
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "ascribeDirective",
        "superType": "keyword",
        "description": "A built-in directive's `@` and name."
      },
      {
        "id": "ascribeWidget",
        "superType": "function",
        "description": "A project widget's `@` and name."
      },
      {
        "id": "ascribeAttributeKey",
        "superType": "property",
        "description": "An attribute key in a `{…}` block."
      },
      {
        "id": "ascribeAttributeValue",
        "superType": "string",
        "description": "An attribute value."
      },
      {
        "id": "ascribeColon",
        "superType": "operator",
        "description": "The colon that ends a directive's head."
      },
      {
        "id": "ascribeEnd",
        "superType": "keyword",
        "description": "The `@end` of an end line."
      },
      {
        "id": "ascribeTitle",
        "superType": "string",
        "description": "A title line (SPEC §3.7), shown distinctly so an accidental title stands out."
      },
      {
        "id": "ascribePhrase",
        "superType": "variable",
        "description": "A declared phrase, `{key}`."
      },
      {
        "id": "ascribePhraseUndeclared",
        "superType": "variable",
        "description": "A `{key}` the content model doesn't declare."
      },
      {
        "id": "ascribeAvailability",
        "superType": "constant",
        "description": "An availability spec."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "markdown",
        "scopes": {
          "ascribeDirective": [
            "keyword.control.directive.ascribe"
          ],
          "ascribeWidget": [
            "entity.name.function.widget.ascribe"
          ],
          "ascribeAttributeKey": [
            "entity.other.attribute-name.ascribe"
          ],
          "ascribeAttributeValue": [
            "string.unquoted.attribute-value.ascribe"
          ],
          "ascribeColon": [
            "punctuation.separator.directive.ascribe"
          ],
          "ascribeEnd": [
            "keyword.control.end.ascribe"
          ],
          "ascribeTitle": [
            "markup.heading.title.ascribe"
          ],
          "ascribePhrase": [
            "variable.other.phrase.ascribe"
          ],
          "ascribePhraseUndeclared": [
            "invalid.illegal.phrase-undeclared.ascribe"
          ],
          "ascribeAvailability": [
            "constant.other.availability.ascribe"
          ],
          "ascribeAttributeKey.unknown": [
            "invalid.illegal.attribute-unknown.ascribe"
          ]
        }
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "unknown",
        "description": "An attribute key the directive's schema doesn't declare."
      }
    ],
    "configurationDefaults": {
      "[markdown]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
