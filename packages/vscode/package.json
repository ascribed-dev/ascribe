        },
        {
          "command": "ascribe.action.copyLinkToSection",
          "when": "ascribe.inProject && editorLangId == markdown"
        },
        {
          "command": "ascribe.action.insertNote",
          "when": "ascribe.inProject && editorLangId == markdown"
        },
        {
