          "command": "ascribe.action.setNoteType",
          "when": "ascribe.inProject && editorLangId == markdown"
        },
        {
          "command": "ascribe.action.unwrapNote",
          "when": "ascribe.inProject && editorLangId == markdown"
        },
        {
          "command": "ascribe.action.noteToDetails",
          "when": "ascribe.inProject && editorLangId == markdown"
        },
        {
          "command": "ascribe.action.wrapDetails",
          "when": "ascribe.inProject && editorLangId == markdown"
        },
        {
          "command": "ascribe.action.unwrapDetails",
