          "when": "ascribe.inProject && editorLangId == markdown"
        },
        {
          "command": "ascribe.action.insertWidget",
          "when": "ascribe.inProject && editorLangId == markdown"
        }
      ],
      "editor/title": [
        {
          "command": "ascribe.openPreview",
          "when": "ascribe.active && resourceLangId == markdown",
          "group": "navigation"
        },
        {
          "command": "ascribe.openSitePreview",
          "when": "ascribe.active && ascribe.devServer && resourceLangId == markdown",
          "group": "navigation"
        },
        {
          "command": "ascribe.startReview",
          "when": "activeWebviewPanelId == 'ascribe.preview' && !ascribe.reviewOn",
          "group": "navigation"
        },
        {
          "command": "ascribe.changedPages",
          "when": "activeWebviewPanelId == 'ascribe.preview' && ascribe.reviewOn",
          "group": "navigation"
        },
        {
          "command": "ascribe.refreshComments",
          "when": "activeWebviewPanelId == 'ascribe.preview' && ascribe.reviewOn",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "ascribe.projects.refresh",
          "when": "view == ascribe.projects",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "ascribe.projects.showOutput",
          "when": "view == ascribe.projects && viewItem =~ /^ascribe\\.project\\./",
          "group": "inline@1"
        },
        {
          "command": "ascribe.projects.restart",
          "when": "view == ascribe.projects && viewItem =~ /^ascribe\\.project\\.(running|failed)$/",
          "group": "inline@2"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "ascribe.review.addToReview",
          "when": "commentController == ascribe.review && (commentThreadIsEmpty || commentThread =~ /\\bcanReply\\b/)",
          "group": "inline@1"
        },
        {
          "command": "ascribe.review.replyNow",
          "when": "commentController == ascribe.review && !commentThreadIsEmpty && commentThread =~ /\\bcanReply\\b/",
          "group": "inline@2"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "ascribe.review.resolve",
          "when": "commentController == ascribe.review && commentThread =~ /\\bcanResolve\\b/",
          "group": "inline"
        },
        {
          "command": "ascribe.review.reopen",
          "when": "commentController == ascribe.review && commentThread =~ /\\bcanUnresolve\\b/",
          "group": "inline"
        }
      ],
      "editor/context": [
        {
          "submenu": "ascribe.actions",
          "when": "ascribe.inProject && editorLangId == markdown",
          "group": "1_modification@9"
        }
      ],
      "ascribe.actions": [
        {
          "command": "ascribe.actions",
          "group": "0_bar@1"
        },
        {
          "command": "ascribe.action.wrapNote",
          "when": "ascribe.selection.blocks || ascribe.selection.proseOrNone && ascribe.at.paragraph",
          "group": "3_structure@1"
        },
        {
          "command": "ascribe.action.setNoteType",
          "when": "ascribe.at.note",
          "group": "3_structure@2"
        },
        {
          "command": "ascribe.action.unwrapNote",
          "when": "ascribe.at.note",
          "group": "3_structure@3"
        },
        {
          "command": "ascribe.action.noteToDetails",
          "when": "ascribe.at.note",
          "group": "3_structure@4"
        },
        {
          "command": "ascribe.action.wrapDetails",
          "when": "ascribe.selection.blocks || ascribe.selection.proseOrNone && ascribe.at.block",
          "group": "3_structure@5"
        },
        {
          "command": "ascribe.action.unwrapDetails",
          "when": "ascribe.at.details",
          "group": "3_structure@6"
        },
        {
          "command": "ascribe.action.makeSteps",
          "when": "ascribe.at.numberedList",
          "group": "3_structure@7"
        },
        {
          "command": "ascribe.action.removeSteps",
          "when": "ascribe.at.steps",
          "group": "3_structure@8"
        },
        {
          "command": "ascribe.action.addHeadingId",
          "when": "ascribe.at.headingWithoutAtId",
          "group": "4_link@1"
        },
        {
          "command": "ascribe.action.copyLinkToSection",
          "when": "ascribe.at.headingWithId",
          "group": "4_link@2"
        },
        {
          "command": "ascribe.action.insertNote",
          "when": "ascribe.insertable",
          "group": "2_write@1"
        },
        {
          "command": "ascribe.action.insertSteps",
          "when": "ascribe.insertable",
          "group": "2_write@2"
        },
        {
          "command": "ascribe.action.insertDetails",
          "when": "ascribe.insertable",
          "group": "2_write@3"
        },
        {
          "command": "ascribe.action.insertVariantGroup",
          "when": "ascribe.insertable",
          "group": "3_structure@9"
        },
        {
          "command": "ascribe.action.addVariantArm",
          "when": "ascribe.at.dimensionGroup",
          "group": "3_structure@10"
        },
        {
          "command": "ascribe.action.removeVariantArm",
          "when": "ascribe.at.removableArm",
          "group": "3_structure@11"
        },
        {
          "command": "ascribe.action.markAvailable",
          "when": "ascribe.at.markable",
          "group": "3_structure@12"
        },
        {
          "command": "ascribe.action.setPageVariant",
          "when": "ascribe.inPage",
          "group": "3_structure@13"
        },
        {
          "command": "ascribe.action.setPageAvailable",
          "when": "ascribe.inPage",
          "group": "3_structure@14"
        },
        {
          "command": "ascribe.action.linkSelection",
          "when": "ascribe.selection.prose",
          "group": "4_link@3"
        },
        {
          "command": "ascribe.action.insertLink",
          "when": "ascribe.cursor && ascribe.at.text",
          "group": "4_link@4"
        },
        {
          "command": "ascribe.action.setLinkTarget",
          "when": "ascribe.at.link",
          "group": "4_link@5"
        },
        {
          "command": "ascribe.action.useTargetTitle",
          "when": "ascribe.at.linkWithText",
          "group": "4_link@6"
        },
        {
          "command": "ascribe.action.insertPhrase",
          "when": "ascribe.cursor && ascribe.at.text",
          "group": "2_write@4"
        },
        {
          "command": "ascribe.action.insertImage",
          "when": "ascribe.insertable",
          "group": "5_media@1"
        },
        {
          "command": "ascribe.action.setImageWidth",
          "when": "ascribe.at.image",
          "group": "5_media@2"
        },
        {
          "command": "ascribe.action.setImageAlt",
          "when": "ascribe.at.image",
          "group": "5_media@3"
        },
        {
          "command": "ascribe.action.insertInclude",
          "when": "ascribe.insertable",
          "group": "5_media@4"
        },
        {
          "command": "ascribe.action.insertSnippet",
          "when": "ascribe.insertable",
          "group": "5_media@5"
        },
        {
          "command": "ascribe.action.insertWidget",
          "when": "ascribe.insertable",
          "group": "5_media@6"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ascribe.actions",
        "key": "ctrl+k a",
        "mac": "cmd+k a",
        "when": "editorTextFocus && ascribe.inProject && editorLangId == markdown"
      }
    ],
    "submenus": [
      {
        "id": "ascribe.actions",
        "label": "Ascribe"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "stage-server": "node scripts/stage-server.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.webview.json",
    "test": "vitest run --passWithNoTests",
    "test:integration": "node esbuild.mjs --tests && node out/integration/run.cjs",
    "test:integration:headless": "xvfb-run -a pnpm run test:integration",
    "test:parity": "vitest run --config vitest.parity.config.ts"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  },
  "devDependencies": {
    "@ascribed/elements": "workspace:*",
    "@ascribed/review": "workspace:*",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@types/vscode": "~1.138.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.2",
    "playwright-core": "^1.50.0",
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Ascribe runs the project own ascribe binary (node_modules/.bin/ascribe or the ascribe.path setting), which is code the workspace supplies."
    }
  }
}
