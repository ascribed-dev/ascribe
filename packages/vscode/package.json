{
  "name": "tessera-vscode",
  "displayName": "Tessera",
  "version": "0.0.0",
  "description": "The Tessera extension for VS Code.",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "publisher": "tessera",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "workspaceContains:**/ascribe.toml"
  ],
  "tessera": {
    "minServerVersion": "0.0.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "tessera.restartServer",
        "title": "Restart Language Server",
        "category": "Tessera"
      },
      {
        "command": "tessera.showOutput",
        "title": "Show Server Output",
        "category": "Tessera"
      }
    ],
    "configuration": {
      "title": "Tessera",
      "properties": {
        "tessera.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the `ascribe` binary. When empty, the extension uses the project's `node_modules/.bin/tessera`, then the binary bundled with the extension."
        },
        "tessera.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server."
        },
        "tessera.formatOnSave": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Format Tessera files into canonical form when saving. Used by the formatter (a later phase); it has no effect until the server offers formatting."
        },
        "tessera.maxCrashes": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "markdownDescription": "How many crashes of the language server, since it was last restarted by hand, make the extension stop restarting it and explain why."
        }
      }
    },
    "grammars": [
      {
        "scopeName": "tessera.injection",
        "path": "./syntaxes/tessera.injection.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.ascribe": "tessera"
        }
      },
      {
        "scopeName": "tessera.injection.nested",
        "path": "./syntaxes/tessera.injection.nested.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ]
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "tesseraDirective",
        "superType": "keyword",
        "description": "A built-in directive's `@` and name."
      },
      {
        "id": "tesseraWidget",
        "superType": "function",
        "description": "A project widget's `@` and name."
      },
      {
        "id": "tesseraAttributeKey",
        "superType": "property",
        "description": "An attribute key in a `{\u2026}` block."
      },
      {
        "id": "tesseraAttributeValue",
        "superType": "string",
        "description": "An attribute value."
      },
      {
        "id": "tesseraColon",
        "superType": "operator",
        "description": "The colon that ends a directive's head."
      },
      {
        "id": "tesseraEnd",
        "superType": "keyword",
        "description": "The `@end` of an end line."
      },
      {
        "id": "tesseraTitle",
        "superType": "string",
        "description": "A title line (SPEC \u00a73.7), shown distinctly so an accidental title stands out."
      },
      {
        "id": "tesseraPhrase",
        "superType": "variable",
        "description": "A declared phrase, `{key}`."
      },
      {
        "id": "tesseraPhraseUndeclared",
        "superType": "variable",
        "description": "A `{key}` the content model doesn't declare."
      },
      {
        "id": "tesseraAvailability",
        "superType": "constant",
        "description": "An availability spec."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "markdown",
        "scopes": {
          "tesseraDirective": [
            "keyword.control.directive.ascribe"
          ],
          "tesseraWidget": [
            "entity.name.function.widget.ascribe"
          ],
          "tesseraAttributeKey": [
            "entity.other.attribute-name.ascribe"
          ],
          "tesseraAttributeValue": [
            "string.unquoted.attribute-value.ascribe"
          ],
          "tesseraColon": [
            "punctuation.separator.directive.ascribe"
          ],
          "tesseraEnd": [
            "keyword.control.end.ascribe"
          ],
          "tesseraTitle": [
            "markup.heading.title.ascribe"
          ],
          "tesseraPhrase": [
            "variable.other.phrase.ascribe"
          ],
          "tesseraPhraseUndeclared": [
            "invalid.illegal.phrase-undeclared.ascribe"
          ],
          "tesseraAvailability": [
            "constant.other.availability.ascribe"
          ],
          "tesseraAttributeKey.unknown": [
            "invalid.illegal.attribute-unknown.ascribe"
          ]
        }
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "unknown",
        "description": "An attribute key the directive's schema doesn't declare."
      }
    ],
    "configurationDefaults": {
      "[markdown]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "tessera.restartServer",
          "when": "tessera.active"
        },
        {
          "command": "tessera.showOutput",
          "when": "tessera.active"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "node esbuild.mjs --tests && node out/integration/run.cjs",
    "test:integration:headless": "xvfb-run -a pnpm run test:integration"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.25.0",
    "mocha": "^11.0.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.15",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Tessera runs the project's own tessera binary (node_modules/.bin/tessera or the tessera.path setting), which is code the workspace supplies."
    }
  }
}
