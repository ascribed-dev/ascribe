{
  "name": "ascribe-vscode",
  "displayName": "Ascribe",
  "version": "0.2.0",
  "description": "The Ascribe extension for VS Code.",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ascribed-dev/ascribe.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://ascribed-dev.com/guides/editor/",
  "bugs": "https://github.com/ascribed-dev/ascribe/issues",
  "publisher": "Ascribe",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#13171f",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "ascribe",
    "markdown",
    "documentation",
    "docs-as-code",
    "language-server"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "workspaceContains:**/ascribe.toml",
    "onWebviewPanel:ascribe.preview"
  ],
  "ascribe": {
    "minServerVersion": "0.2.0"
  },
