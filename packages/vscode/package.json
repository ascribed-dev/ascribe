          "when": "ascribe.inProject && editorLangId == markdown"
        },
        {
          "command": "ascribe.action.addVariantArm",
          "when": "ascribe.inProject && editorLangId == markdown"
        },
        {
          "command": "ascribe.action.removeVariantArm",
          "when": "ascribe.inProject && editorLangId == markdown"
        },
        {
          "command": "ascribe.action.markAvailable",
          "when": "ascribe.inProject && editorLangId == markdown"
        },
        {
          "command": "ascribe.action.setPageVariant",
          "when": "ascribe.inProject && editorLangId == markdown"
        },
        {
          "command": "ascribe.action.setPageAvailable",
          "when": "ascribe.inProject && editorLangId == markdown"
        },
        {
          "command": "ascribe.action.linkSelection",
          "when": "ascribe.inProject && editorLangId == markdown"
        },
        {
          "command": "ascribe.action.insertLink",
          "when": "ascribe.inProject && editorLangId == markdown"
        },
        {
          "command": "ascribe.action.setLinkTarget",
          "when": "ascribe.inProject && editorLangId == markdown"
        },
