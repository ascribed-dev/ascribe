{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ascribe (markdown injection)",
  "scopeName": "ascribe.injection",
  "injectionSelector": "L:text.html.markdown -markup.fenced_code -markup.inline.raw -markup.raw -meta.embedded -comment -text.html.derivative -meta.attributes.ascribe -string.unquoted.identifier.primary.ascribe -constant.other.availability.ascribe -markup.list -markup.quote",
  "patterns": [
    {
      "include": "#indented-code"
    },
    {
      "include": "#content"
    }
  ],
  "repository": {
    "indented-code": {
      "match": "^(?: {4}|\\t).*$"
    },
    "content": {
      "patterns": [
        {
          "include": "#end-line"
        },
        {
          "include": "#directive-identifier"
        },
        {
          "include": "#directive-availability"
        },
        {
          "include": "#directive-builtin"
        },
        {
          "include": "#directive-widget"
        },
        {
          "include": "#phrase"
        }
      ]
    },
    "end-line": {
      "match": "(?:^|\\G)(?:[ \\t]*>)*[ \\t]*(@)(end)[ \\t]*$",
      "name": "meta.directive.end.ascribe",
      "captures": {
        "1": {
          "name": "punctuation.definition.directive.ascribe"
        },
        "2": {
          "name": "keyword.control.end.ascribe"
        }
      }
    },
    "directive-identifier": {
      "match": "(?:^|\\G)(?:[ \\t]*>)*[ \\t]*(@)(id|include)(?![A-Za-z0-9_-])[ \\t]*(\\{(?:\"(?:[^\"\\\\\\n]|\\\\.)*(?:\"|$)|[^}\"\\n])*(?:\\}|$))?[ \\t]*(?:(:)[ \\t]*(\\S*))?[ \\t]*$",
      "name": "meta.directive.ascribe",
      "captures": {
        "1": {
          "name": "punctuation.definition.directive.ascribe"
        },
        "2": {
          "name": "keyword.control.directive.ascribe"
        },
        "3": {
          "name": "meta.attributes.ascribe",
          "patterns": [
            {
              "include": "#attributes"
            }
          ]
        },
        "4": {
          "name": "punctuation.separator.directive.ascribe"
        },
        "5": {
          "name": "meta.primary.ascribe string.unquoted.identifier.primary.ascribe"
        }
      }
    },
    "directive-availability": {
      "match": "(?:^|\\G)(?:[ \\t]*>)*[ \\t]*(@)(available)(?![A-Za-z0-9_-])[ \\t]*(\\{(?:\"(?:[^\"\\\\\\n]|\\\\.)*(?:\"|$)|[^}\"\\n])*(?:\\}|$))?[ \\t]*(?:(:)[ \\t]*(.*?))?[ \\t]*$",
      "name": "meta.directive.ascribe",
      "captures": {
        "1": {
          "name": "punctuation.definition.directive.ascribe"
        },
        "2": {
          "name": "keyword.control.directive.ascribe"
        },
        "3": {
          "name": "meta.attributes.ascribe",
          "patterns": [
            {
              "include": "#attributes"
            }
          ]
        },
        "4": {
          "name": "punctuation.separator.directive.ascribe"
        },
        "5": {
          "name": "meta.primary.ascribe constant.other.availability.ascribe"
        }
      }
    },
    "directive-builtin": {
      "match": "(?:^|\\G)(?:[ \\t]*>)*[ \\t]*(@)(variant|note|steps|details)(?![A-Za-z0-9_-])[ \\t]*(\\{(?:\"(?:[^\"\\\\\\n]|\\\\.)*(?:\"|$)|[^}\"\\n])*(?:\\}|$))?[ \\t]*(?:(:)[ \\t]*(.*?))?[ \\t]*$",
      "name": "meta.directive.ascribe",
      "captures": {
        "1": {
          "name": "punctuation.definition.directive.ascribe"
        },
        "2": {
          "name": "keyword.control.directive.ascribe"
        },
        "3": {
          "name": "meta.attributes.ascribe",
          "patterns": [
            {
              "include": "#attributes"
            }
          ]
        },
        "4": {
          "name": "punctuation.separator.directive.ascribe"
        },
        "5": {
          "name": "meta.primary.ascribe",
          "patterns": [
            {
              "include": "#phrase"
            },
            {
              "include": "text.html.markdown#inline"
            }
          ]
        }
      }
    },
    "directive-widget": {
      "match": "(?:^|\\G)(?:[ \\t]*>)*[ \\t]*(@)([a-z][a-z0-9]*(?:-[a-z0-9]+)+)(?![A-Za-z0-9_-])[ \\t]*(\\{(?:\"(?:[^\"\\\\\\n]|\\\\.)*(?:\"|$)|[^}\"\\n])*(?:\\}|$))?[ \\t]*(?:(:)[ \\t]*(.*?))?[ \\t]*$",
      "name": "meta.directive.ascribe",
      "captures": {
        "1": {
          "name": "punctuation.definition.directive.ascribe"
        },
        "2": {
          "name": "entity.name.function.widget.ascribe"
        },
        "3": {
          "name": "meta.attributes.ascribe",
          "patterns": [
            {
              "include": "#attributes"
            }
          ]
        },
        "4": {
          "name": "punctuation.separator.directive.ascribe"
        },
        "5": {
          "name": "meta.primary.ascribe",
          "patterns": [
            {
              "include": "#phrase"
            },
            {
              "include": "text.html.markdown#inline"
            }
          ]
        }
      }
    },
    "attributes": {
      "patterns": [
        {
          "match": "\\{",
          "name": "punctuation.section.attributes.begin.ascribe"
        },
        {
          "match": "\\}",
          "name": "punctuation.section.attributes.end.ascribe"
        },
        {
          "match": "[a-z][a-z0-9-]*(?=[ \\t]*=)",
          "name": "entity.other.attribute-name.ascribe"
        },
        {
          "match": "=",
          "name": "punctuation.separator.key-value.ascribe"
        },
        {
          "match": "[,|]",
          "name": "punctuation.separator.attributes.ascribe"
        },
        {
          "begin": "\"",
          "end": "\"|$",
          "name": "string.quoted.double.ascribe",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.ascribe"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.ascribe"
            }
          },
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.ascribe"
            }
          ]
        },
        {
          "match": "[^\\s,|{}=\"]+",
          "name": "string.unquoted.attribute-value.ascribe"
        }
      ]
    },
    "phrase": {
      "match": "(?<!\\\\)(\\{)([a-z][a-z0-9-]*)(\\})",
      "name": "meta.phrase.ascribe",
      "captures": {
        "1": {
          "name": "punctuation.definition.phrase.begin.ascribe"
        },
        "2": {
          "name": "variable.other.phrase.ascribe"
        },
        "3": {
          "name": "punctuation.definition.phrase.end.ascribe"
        }
      }
    }
  }
}
