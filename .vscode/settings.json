{
  // Only the docs and the site's pages are projects to work on here, so each
  // other ascribe.toml gets no language server and isn't in Switch Project:
  // the test fixtures; target/, where `cargo test` writes projects
  // (CARGO_TARGET_TMPDIR); and the examples and site/demo, which the docs read as
  // code, not as projects. To work on an example with the editor's help,
  // take its pattern out while you do.
  "ascribe.projects.exclude": [
    "tests/**",
    "crates/*/tests/**",
    "packages/vscode/test/**",
    "target/**",
    "examples/**",
    "site/demo/**"
  ],
  // The copy of VS Code the extension's integration tests download: as plain
  // text, its extensions' manifests aren't checked as if they were ours.
  "files.associations": {
    "**/packages/vscode/out/vscode-test/**": "plaintext"
  },
  "[markdown]": {
    "editor.defaultFormatter": "Ascribe.ascribe-vscode"
  }
}
