{
  "$defs": {
    "LspCreateFile": {
      "description": "A file to create, empty.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/LspCreateKind",
          "description": "`create`."
        },
        "options": {
          "anyOf": [
            {
              "$ref": "#/$defs/LspCreateFileOptions"
            },
            {
              "type": "null"
            }
          ],
          "description": "What to do when it's there already."
        },
        "uri": {
          "description": "The file's URI.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "uri"
      ],
      "type": "object"
    },
    "LspCreateFileOptions": {
      "description": "What to do when a file to create is there already.",
      "properties": {
        "ignoreIfExists": {
          "description": "Whether to leave it as it is, and go on.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "overwrite": {
          "description": "Whether to write over it.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "LspCreateKind": {
      "description": "The kind of a file to create.",
      "oneOf": [
        {
          "const": "create",
          "description": "A file to create.",
          "type": "string"
        }
      ]
    },
    "LspDocumentChange": {
      "anyOf": [
        {
          "$ref": "#/$defs/LspCreateFile",
          "description": "A file to create."
        },
        {
          "$ref": "#/$defs/LspTextDocumentEdit",
          "description": "Edits to one document."
        }
      ],
      "description": "A file to create, or edits to one document."
    },
    "LspPosition": {
      "description": "A position in a document: a zero-based line, and a zero-based column in\nthe position encoding the client and server agreed on.",
      "properties": {
        "character": {
          "description": "The column, from 0, in the negotiated position encoding.",
          "minimum": 0,
          "type": "integer"
        },
        "line": {
          "description": "The line, from 0.",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "line",
        "character"
      ],
      "type": "object"
    },
    "LspRange": {
      "description": "A range in a document, from `start` up to (not including) `end`.",
      "properties": {
        "end": {
          "$ref": "#/$defs/LspPosition",
          "description": "Where it ends."
        },
        "start": {
          "$ref": "#/$defs/LspPosition",
          "description": "Where it starts."
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "LspTextDocumentEdit": {
      "description": "Edits to one document.",
      "properties": {
        "edits": {
          "description": "Its edits, each to the document as it is before any of them.",
          "items": {
            "$ref": "#/$defs/LspTextEdit"
          },
          "type": "array"
        },
        "textDocument": {
          "$ref": "#/$defs/LspVersionedDocument",
          "description": "The document."
        }
      },
      "required": [
        "textDocument",
        "edits"
      ],
      "type": "object"
    },
    "LspTextEdit": {
      "description": "A text edit: replace `range` with `newText`.",
      "properties": {
        "newText": {
          "description": "The text that replaces it.",
          "type": "string"
        },
        "range": {
          "$ref": "#/$defs/LspRange",
          "description": "The range to replace, in the document as it is before the edit."
        }
      },
      "required": [
        "range",
        "newText"
      ],
      "type": "object"
    },
    "LspVersionedDocument": {
      "description": "A document, and the version an edit is for; `null` for any.",
      "properties": {
        "uri": {
          "description": "Its URI.",
          "type": "string"
        },
        "version": {
          "description": "The version.",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "uri",
        "version"
      ],
      "type": "object"
    },
    "LspWorkspaceEdit": {
      "description": "Changes to documents: `changes`, or, for an edit that creates a file,\n`documentChanges`.",
      "properties": {
        "changes": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/LspTextEdit"
            },
            "type": "array"
          },
          "description": "The edits to each document, by its URI.",
          "type": [
            "object",
            "null"
          ]
        },
        "documentChanges": {
          "description": "Files to create and edits to make, in order: each file is created\nbefore the edit that gives it its text.",
          "items": {
            "$ref": "#/$defs/LspDocumentChange"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "description": "The edit, which may change nothing.",
      "properties": {
        "edit": {
          "$ref": "#/$defs/LspWorkspaceEdit",
          "description": "Edits to each file it changes, under `documentChanges`, in path\norder: an open document's names the version it's for, and any\nother's `null`."
        },
        "files": {
          "description": "How many files it changes.",
          "minimum": 0,
          "type": "integer"
        },
        "fixes": {
          "description": "For the safe fixes, how many problems they fix; `null` for\nformatting.",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "edit",
        "files",
        "fixes"
      ],
      "type": "object"
    },
    {
      "description": "Why there's no edit: a plain-language sentence, for the client to\nshow.",
      "properties": {
        "error": {
          "description": "The message.",
          "type": "string"
        }
      },
      "required": [
        "error"
      ],
      "type": "object"
    }
  ],
  "description": "The answer to `ascribe/projectEdit`: the edit and how much it changes, or\nwhy there's none.",
  "title": "ProjectEditResult"
}
