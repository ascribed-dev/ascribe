{
  "name": "ascribe-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:all": "node scripts/build-all.ts",
    "check:packages": "node scripts/release/consumers.ts",
    "lint": "oxlint --type-aware",
    "typecheck": "tsc -p scripts/tsconfig.json && pnpm -r typecheck",
    "test": "vitest run --dir scripts && pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^25.9.9",
    "@types/vscode": "~1.140.0",
    "@vscode/test-electron": "^3.1.0",
    "knip": "6.39.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "sharp": "^0.35.5",
    "smol-toml": "^1.9.0",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3"
  }
}
