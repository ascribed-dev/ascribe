{
  "README": "Each docs page, the paths it has had, and the code it describes. `paths` lists every file that held the page, newest first: the back-test uses whichever existed at the pull request's base. `covers` are globs over the repository (`*` within a segment, `**` across segments), written for what the page is about, not tuned to any result.",
  "pages": {
    "docs/README.md": {
      "paths": ["docs/README.md"],
      "covers": []
    },
    "docs/getting-started.md": {
      "paths": ["docs/getting-started.md"],
      "covers": [
        "packages/cli/package.json",
        "packages/cli/src/**",
        "packages/cli/platforms/*/package.json"
      ]
    },
    "docs/directives.md": {
      "paths": ["docs/directives.md"],
      "covers": [
        "crates/tessera-syntax/src/**",
        "crates/comrak-tessera/src/tessera.rs",
        "crates/tessera-resolve/src/build/**",
        "crates/tessera-resolve/src/expand.rs",
        "crates/tessera-resolve/src/slug/**",
        "crates/tessera-fmt/src/**"
      ]
    },
    "docs/content-model.md": {
      "paths": ["docs/content-model.md"],
      "covers": ["crates/tessera-model/src/**"]
    },
    "docs/cli.md": {
      "paths": ["docs/cli.md", "crates/tessera-cli/README.md"],
      "covers": [
        "crates/tessera-cli/src/cli.rs",
        "crates/tessera-cli/src/exit.rs",
        "crates/tessera-cli/src/commands/**",
        "crates/tessera-cli/src/report/**",
        "crates/tessera-diff/src/html/**"
      ]
    },
    "docs/review.md": {
      "paths": ["docs/review.md"],
      "covers": [
        "packages/review/src/**",
        "packages/astro/src/review/**",
        "packages/astro/src/toolbar/**",
        "packages/vscode/src/preview/review*.ts",
        "packages/vscode/src/preview/threads*.ts",
        "packages/vscode/src/preview/sourceComments.ts",
        "packages/vscode/src/webview/review.ts",
        "packages/vscode/src/webview/threads.ts",
        "crates/tessera-lsp/src/review.rs",
        "crates/tessera-cli/src/commands/diff.rs",
        "crates/tessera-diff/src/html/**"
      ]
    },
    "docs/diagnostics.md": {
      "paths": ["docs/diagnostics.md"],
      "covers": ["tests/conformance/diagnostics.toml"]
    },
    "docs/editor.md": {
      "paths": ["docs/editor.md", "packages/vscode/README.md"],
      "covers": [
        "packages/vscode/package.json",
        "packages/vscode/src/**",
        "packages/vscode/syntaxes/**",
        "crates/tessera-lsp/src/**",
        "crates/tessera-cli/src/commands/lsp.rs"
      ]
    },
    "docs/astro.md": {
      "paths": ["docs/astro.md", "packages/astro/README.md"],
      "covers": ["packages/astro/src/**", "packages/astro/package.json"]
    },
    "docs/contracts/content-model.md": {
      "paths": ["docs/contracts/content-model.md", "project-docs/content-model.md"],
      "covers": ["crates/tessera-model/src/**"]
    },
    "docs/contracts/output-layout.md": {
      "paths": ["docs/contracts/output-layout.md", "project-docs/contracts/output-layout.md"],
      "covers": [
        "crates/tessera-emit/src/store.rs",
        "crates/tessera-emit/src/emitter.rs",
        "crates/tessera-emit/src/lib.rs"
      ]
    },
    "docs/contracts/assets.md": {
      "paths": ["docs/contracts/assets.md", "project-docs/contracts/assets.md"],
      "covers": [
        "crates/tessera-emit/src/assets.rs",
        "crates/tessera-resolve/src/references.rs",
        "packages/vscode/src/preview/refs.ts"
      ]
    },
    "docs/contracts/site-render.md": {
      "paths": ["docs/contracts/site-render.md", "project-docs/contracts/site-render.md"],
      "covers": [
        "crates/tessera-emit/src/site/**",
        "packages/astro/src/attributes.ts",
        "packages/astro/src/rehype.ts"
      ]
    }
  }
}
