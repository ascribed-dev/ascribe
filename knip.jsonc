{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // `ascribe` comes from this repository's own build, not a package, and
  // `pgrep` from the system, where the extension finds a server's children.
  "ignoreBinaries": ["ascribe", "pgrep"],
  // The docs site is its own npm project, installed from the published
  // packages, and "Site from npm" checks it (site-npm.yml).
  "ignore": ["site/**"],
  // With one content type, the generated `schema` is that type's schema.
  "ignoreIssues": {
    "tests/zod/generated/*.ts": ["duplicates"],
    // Generated whole from crates/ascribe-core/src/names.rs: every package
    // gets every name, whichever it uses.
    "packages/*/src/names.ts": ["exports"],
    // Generated whole from the Rust types by crates/ascribe-cli/src/shapes.rs:
    // every type a shape refers to, whichever the package names.
    "packages/*/src/shapes.ts": ["types"],
  },
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{ts,cts}"],
      "project": ["scripts/**/*.{ts,cts,mjs}"],
      // VS Code provides `vscode` to the release smoke test's suite, which runs inside it.
      // scripts/release/consumers.ts runs `publint` and `attw` by name.
      "ignoreDependencies": ["vscode", "publint", "@arethetypeswrong/cli"],
    },
    // The published packages: each path their `exports` names is a contract,
    // so its exports count as used.
    // An archive's search script, embedded in the binary; not published.
    "packages/archive": {
      "entry": ["src/index.ts"],
    },
    "packages/astro": {
      // `src/cli.ts` is the package's command (`bin`).
      "entry": [
        "src/index.ts",
        "src/rehype.ts",
        "src/satteri.ts",
        "src/content.ts",
        "src/cli.ts",
        "src/*.astro",
      ],
      // The starter's files, which `init` reads by path and copies into a site.
      "ignore": ["starter/**"],
    },
    "packages/cli": {
      "entry": ["scripts/*.mjs"],
    },
    "packages/elements": {
      "entry": ["src/index.ts"],
      // The accessibility test reads `axe-core/axe.min.js` by path, into the page.
      "ignoreDependencies": ["axe-core"],
    },
    "packages/review": {
      "entry": [
        "src/github/index.ts",
        "src/marks/index.ts",
        "src/overlay/index.ts",
        "src/place/index.ts",
        "src/prompt/index.ts",
      ],
    },
    "examples/astro-site": {
      // The docs' scenes of the site and the report, which scripts/docs-site/screenshots.ts runs.
      "entry": ["scripts/screenshot.ts"],
    },
    "packages/vscode": {
      // The site's editor picture, which scripts/docs-site/screenshots.ts runs.
      "entry": ["scripts/screenshot.ts"],
      // Release packaging runs `vsce` by name (scripts/release/pack.ts and
      // publish.ts), and the language server packages are the test stub's
      // (test/stub-server/ascribe), a script with no extension. The webview
      // views' stylesheet imports `@vscode/codicons`' stylesheet, which
      // esbuild.mjs bundles with its font.
      "ignoreDependencies": [
        "@vscode/codicons",
        "@vscode/vsce",
        "vscode-languageserver",
        "vscode-languageserver-textdocument",
      ],
    },
    "tests/zod": {
      // The modules `ascribe build` generates, which the test checks whole.
      "entry": ["schema.test.ts", "generated/*.ts"],
    },
  },
}
