# Rust
/target/

# JavaScript
node_modules/
dist/
out/
!/design/out/
coverage/
*.tsbuildinfo

# insta writes pending snapshots next to the accepted ones; review them with
# `cargo insta review` rather than committing them.
*.snap.new
*.pending-snap

# OS and editor files
.DS_Store
.playwright-mcp/
# Affinity's lock beside an open file.
*~lock~

# The shared launch and task configurations for running the extension, and
# the workspace settings that leave the test fixtures out of its projects; the
# rest of .vscode/ is each person's own.
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
THIRD-PARTY-NOTICES

# Local mockups

project-docs/mockups/

# The Good Docs Project's files at the pinned commit, fetched by
# scripts/templates/convert.ts and never committed.
scripts/templates/.upstream/

# Agents' worktrees: another checkout, never part of this one.
.claude/worktrees/
