{
  "name": "@ascribed/example-astro-site",
  "version": "0.0.0",
  "description": "A plain Astro site built from an Ascribe project: the Astro end-to-end slice.",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "scripts": {
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --exclude 'test/e2e/**'",
    "test:e2e": "vitest run test/e2e"
  },
  "dependencies": {
    "@ascribed/astro": "workspace:*",
    "@ascribed/cli": "workspace:*",
    "astro": "7.3.5",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@types/node": "^25.9.9",
    "playwright-core": "^1.50.0"
  }
}
