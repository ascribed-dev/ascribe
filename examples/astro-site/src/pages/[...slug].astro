---
import { getCollection, render } from "astro:content";
import Docs from "../layouts/Docs.astro";

// A page's route is the base path plus its entry id, and the root page (id
// `index`) is at the base path itself: what Tessera's router computes for
// every link it writes.
export async function getStaticPaths() {
  const entries = await getCollection("docs");
  return entries.map((entry) => ({
    params: { slug: entry.id === "index" ? undefined : entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<Docs entry={entry} headings={headings}><Content /></Docs>
