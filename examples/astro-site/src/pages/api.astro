---
// Loom's API reference, at /docs/api: Redoc 3, from the pinned `redoc`
// package, drawing the spec the guides link into. Ascribe writes a link to an
// operation as `/docs/api#operation/<operationId>` (ascribe.toml's
// `[apis.loom]`), which Redoc 3 takes for its own address of the operation
// (`#/looms/getloom`) and scrolls to when the page opens. Redoc 3 sends usage
// traces to Redocly unless `disable-telemetry` is "true".
import redoc from "redoc/bundles/redoc.standalone.js?url";
// A file of its own, for a reader without JavaScript, rather than inlined.
import spec from "../../api/openapi.yaml?url&no-inline";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Loom API</title>
  </head>
  <body>
    <h1 class="title">Loom API</h1>
    <p class="title">
      Each operation of Loom's API, with its parameters and its responses, as Redoc draws them
      from <a href={spec}>the spec</a>.
    </p>
    <redoc spec-url={spec} disable-telemetry="true"></redoc>
    <script is:inline type="module" src={redoc}></script>
    <style>
      /* Redoc draws its own title; these are for a reader without JavaScript. */
      .title {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }
    </style>
  </body>
</html>
