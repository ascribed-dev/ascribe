{
  "name": "ascribe-docs-site",
  "version": "0.0.0",
  "description": "Ascribe's user docs (../docs) as a website, installed from npm as a user's site is.",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "follow-next": "node scripts/follow-next.mjs",
    "build:checkout": "node scripts/checkout.mjs",
    "typecheck": "astro sync && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ascribed/astro": "next",
    "@ascribed/cli": "next",
    "@ascribed/elements": "next",
    "astro": "^7.3.5",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "pagefind": "^1.5.2",
    "playwright-core": "^1.50.0",
    "typescript": "~7.0.2",
    "vitest": "^5.0.2"
  }
}
