---
// A docs page: its title, availability, description, content, edit link,
// previous and next pages, and table of contents.
import { getCollection, type CollectionEntry } from "astro:content";
import Availability from "@ascribed/astro/Availability.astro";
import { neighbors, type Formatted } from "@ascribed/astro/content";
import Toc from "../components/Toc.astro";
import { contentDir, repo } from "../site.ts";
import Base from "./Base.astro";

interface Props {
  entry: CollectionEntry<"docs">;
  headings: { depth: number; slug: string; text: string }[];
}

const { entry, headings } = Astro.props;
// `formatted.title` is the title as HTML, with its code spans as <code>
// (`inline = "code"` in ../docs/ascribe.toml); <title> is the record's.
// `source` is the page's path from the content root.
const { formatted, description, available, source } = entry.data;
const edit = `${repo}/edit/main/${contentDir}/${source}`;
// The pages before and after this one in the sidebar's reading order, each
// with its label, formatted (its code spans as <code>).
const { previous, next } = neighbors(entry, await getCollection("docs"), { name: "docs" });
const escape = (text: string) =>
  text.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");
const labelHtml = (of: { label: string; formatted?: Formatted }) =>
  of.formatted?.label ?? escape(of.label);
// The description is in llms.txt and not in the page's Markdown, so it's
// marked for the delivery spec's parity check (`data-markdown-ignore`).
---

<Base entry={entry} current={entry.id} docs>
  <main id="content" class="page">
    <article data-pagefind-body>
      <h1 set:html={formatted.title} />
      <Availability available={available} />
      {description && <p class="description" data-markdown-ignore>{description}</p>}
      <slot />
    </article>
    {
      (previous || next) && (
        <nav class="neighbors" aria-label="Previous and next">
          {previous && (
            <a rel="prev" href={previous.href}>
              <span class="neighbor-label">Previous</span>
              <span set:html={labelHtml(previous)} />
            </a>
          )}
          {next && (
            <a rel="next" href={next.href}>
              <span class="neighbor-label">Next</span>
              <span set:html={labelHtml(next)} />
            </a>
          )}
        </nav>
      )
    }
    <footer class="page-footer">
      <a href={edit}>Edit this page on GitHub</a>
    </footer>
  </main>
  <Toc headings={headings} rendered={entry.rendered?.html} />
</Base>
