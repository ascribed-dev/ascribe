---
// The site's navigation: the docs' sections and pages in ../docs/ascribe.nav's
// order, from the build's navigation, each page with its address and its
// label, formatted (its code spans as <code>). A nested section's pages are
// listed right after its own page, marked as nested, as
// checks/diagnostics/pages.md is after checks/diagnostics.md.
import { getCollection, type CollectionEntry } from "astro:content";
import {
  sidebar,
  type Formatted,
  type SidebarGroup,
  type SidebarPage,
} from "@ascribed/astro/content";

interface Props {
  current?: string | undefined;
}

const { current } = Astro.props;

type Entry = CollectionEntry<"docs">;

const escape = (text: string) =>
  text.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");
/** A label as HTML: its formatted form, or its plain text escaped. */
const labelHtml = (of: { label: string; formatted?: Formatted }) =>
  of.formatted?.label ?? escape(of.label);

interface Item {
  page: SidebarPage<Entry>;
  nested: boolean;
}

/**
 * A group's pages in order, each nested section's right after its own page,
 * or after the group's pages when its own page is its `index.md`.
 */
function items(group: SidebarGroup<Entry>, nested: boolean): Item[] {
  const placed = new Set<SidebarGroup<Entry>>();
  const out: Item[] = [];
  for (const page of group.pages) {
    out.push({ page, nested });
    for (const section of group.sections) {
      if (section.page?.entry !== page.entry) continue;
      placed.add(section);
      out.push(...items(section, true));
    }
  }
  for (const section of group.sections) {
    if (placed.has(section)) continue;
    out.push(...items(section, true));
  }
  return out;
}

const groups = sidebar(await getCollection("docs"), { name: "docs" }).map((group) => ({
  label: labelHtml(group),
  items: items(group, false),
}));
---

<nav id="sidebar" class="sidebar" aria-label="Docs">
  {
    groups.map((group) => (
      <section>
        <h2 set:html={group.label} />
        <ul>
          {group.items.map(({ page, nested }) => (
            <li class={nested ? "nested" : undefined}>
              <a href={page.href} aria-current={page.entry.id === current ? "page" : undefined}>
                <Fragment set:html={labelHtml(page)} />
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</nav>
