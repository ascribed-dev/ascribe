---
// The site's navigation, from src/nav.ts, with each page's title from the
// collection, formatted (its code spans as <code>). A page named in nav.ts that the collection doesn't have fails
// the build.
import { getEntry } from "astro:content";
import { entryId, nav } from "../nav.ts";
import { docsPath } from "../site.ts";

interface Props {
  current?: string | undefined;
}

const { current } = Astro.props;
const docs = `${import.meta.env.BASE_URL}${docsPath}`;

const groups = await Promise.all(
  nav.map(async (group) => ({
    label: group.label,
    pages: await Promise.all(
      group.pages.map(async (file) => {
        const id = entryId(file);
        const entry = await getEntry("docs", id);
        if (!entry) throw new Error(`src/nav.ts names ${file}, which isn't a page of the site`);
        // A page in the folder named for another page listed, as
        // checks/diagnostics/pages.md is in checks/diagnostics.md's, is listed
        // under it. A folder's index.md isn't such a page: its group is the
        // folder already.
        const nested = nav.some((g) =>
          g.pages.some(
            (other) => !other.endsWith("/index.md") && id.startsWith(`${entryId(other)}/`),
          ),
        );
        return {
          id,
          title: entry.data.formatted.title,
          href: id === "index" ? docs : `${docs}${id}/`,
          nested,
        };
      }),
    ),
  })),
);
---

<nav id="sidebar" class="sidebar" aria-label="Docs">
  {
    groups.map((group) => (
      <section>
        <h2>{group.label}</h2>
        <ul>
          {group.pages.map((page) => (
            <li class={page.nested ? "nested" : undefined}>
              <a href={page.href} aria-current={page.id === current ? "page" : undefined}>
                <Fragment set:html={page.title} />
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</nav>
