---
// A page's availability (its `available` frontmatter), as the badge the
// element library styles: the same markup the site output gives a section's,
// as examples/astro-site has it (issue #96).
interface Props {
  available:
    | {
        target: string;
        dimension: string;
        states: string[];
        versions?: string[] | undefined;
        text: string;
      }[]
    | undefined;
}

const { available } = Astro.props;
---

{
  available && available.length > 0 && (
    <ascribe-availability scope="page">
      {available.map((item, i) => (
        <>
          {i > 0 && "; "}
          <ascribe-availability-target
            target={item.target}
            dimension={item.dimension}
            states={item.states.join(" ")}
            versions={item.versions?.join(" ")}
          >
            {item.text}
          </ascribe-availability-target>
        </>
      ))}
    </ascribe-availability>
  )
}
