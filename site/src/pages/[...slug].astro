---
import { getCollection, render } from "astro:content";
import Demonstrations from "../components/Demonstrations.astro";
import Page from "../layouts/Page.astro";

// The site's own pages, from home/: at the site's root, the base path of that
// project, plus each entry id, with the landing page (id `index`) at `/`.
export async function getStaticPaths() {
  const entries = await getCollection("home");
  return entries.map((entry) => ({
    params: { slug: entry.id === "index" ? undefined : entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
// Through `render()`, which gives the page's images Astro's processing.
const { Content, headings } = await render(entry);
const heading = headings.find((h) => h.depth === 1)?.text;
if (heading === undefined) throw new Error(`${entry.id}: the page has no level-1 heading`);
---

<Page entry={entry} heading={heading}>
  <Demonstrations id={entry.id}><Content /></Demonstrations>
</Page>
