---
import { getCollection, render } from "astro:content";
import Page from "../layouts/Page.astro";

// The site's own pages, from home/: at the site's root, the base path of that
// project, plus each entry id, with the landing page (id `index`) at `/`.
export async function getStaticPaths() {
  const entries = await getCollection("home");
  return entries.map((entry) => ({
    params: { slug: entry.id === "index" ? undefined : entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Page entry={entry}><Content /></Page>
