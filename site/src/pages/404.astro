---
import MissingPermalink from "@ascribed/astro/MissingPermalink.astro";
import Base from "../layouts/Base.astro";
import { docsPath } from "../site.ts";

// Most addresses the site doesn't have are the docs' (a page that moved, or
// one from before the docs were under /docs/), so the 404 page is in their
// frame and offers their start page.
const docs = `${import.meta.env.BASE_URL}${docsPath}`;
---

<Base title="Page not found" docs canonical={false}>
  <main id="content" class="page">
    <article>
      <h1>Page not found</h1>
      <p>
        There's no page at this address. It may have moved: try the navigation, search, or the <a
          href={docs}>docs' start page</a
        >.
      </p>
      {/* The paragraph above already offers the start page and search, so the
      component's own offer, its default children, is replaced with nothing. */}
      <MissingPermalink><Fragment /></MissingPermalink>
    </article>
  </main>
</Base>
