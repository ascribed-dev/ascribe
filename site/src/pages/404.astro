---
import MissingPermalink from "@ascribed/astro/MissingPermalink.astro";
import Base from "../layouts/Base.astro";

const base = import.meta.env.BASE_URL;
---

<Base title="Page not found">
  <main id="content" class="page">
    <article>
      <h1>Page not found</h1>
      <p>
        There's no page at this address. It may have moved: try the navigation, search, or the <a
          href={base}>start page</a
        >.
      </p>
      {/* The paragraph above already offers the start page and search, so the
      component's own offer, its default children, is replaced with nothing. */}
      <MissingPermalink><Fragment /></MissingPermalink>
    </article>
  </main>
</Base>
